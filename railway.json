{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "watchPatterns": [
      "backend/**",
      "frontend/**",
      "railpack.json"
    ]
  },
  "deploy": {
    "startCommand": "cd backend && flask db upgrade && gunicorn app:app",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
