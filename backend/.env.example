# Authentication credentials for HTTP Basic Auth
# Copy this file to .env and update with your actual credentials

# To generate password hashes, run this Python code:
# from werkzeug.security import generate_password_hash
# print(generate_password_hash('your_password'))

# Format: username:password_hash
AUTH_USER1=user1:pbkdf2:sha256:600000$salt$hash
AUTH_USER2=user2:pbkdf2:sha256:600000$salt$hash
